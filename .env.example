# Домен сайта (A-запись домена должна указывать на IP этого VPS)
DOMAIN=profit.example.ru

# Ваш ник в Telegram без @ — для подписи внизу страницы
TG_USERNAME=your_username

# Ключ шифрования API-ключей клиентов. Создаётся командой из README, не меняйте после запуска:
# со сменой ключа все подключённые кабинеты придётся подключать заново.
FERNET_KEY=

# Сколько прошлых месяцев загружать (плюс текущий) и как часто обновлять данные
MONTHS_BACK=3
CACHE_HOURS=6

# Пароль от страницы статистики https://ваш-домен/admin/stats?key=ПАРОЛЬ. Пусто — страница выключена.
# Придумайте длинную случайную строку, например командой для FERNET_KEY из README.
ADMIN_KEY=
